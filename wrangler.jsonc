{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "settlematch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request goes through the Worker, which strips the /settlematch prefix first.
    "run_worker_first": true
  },
  // Only these paths on maushook.com reach the Worker; the rest of the zone is another site.
  "routes": [
    { "pattern": "maushook.com/settlematch", "zone_name": "maushook.com" },
    { "pattern": "maushook.com/settlematch/*", "zone_name": "maushook.com" }
  ],
  // Keep the workers.dev address, which also serves paths without the prefix.
  "workers_dev": true,
  "vars": {
    "AI_MODEL": "claude-haiku-5-5"
  },
  // 5 live AI runs per minute per IP. The sample run uses precomputed results and never hits this.
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
