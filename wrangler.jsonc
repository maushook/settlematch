{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "settlematch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AI_MODEL": "claude-haiku-5-5"
  },
  // 5 live AI runs per minute per IP. The sample run uses precomputed results and never hits this.
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
